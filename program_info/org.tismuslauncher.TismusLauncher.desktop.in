[Desktop Entry]
Version=1.0
Name=@Launcher_DisplayName@
Comment=Manage Minecraft instances the old-fashioned way
Type=Application
Terminal=false
Exec=@Launcher_APP_BINARY_NAME@ %U
StartupNotify=true
Icon=@Launcher_AppID@
Categories=Game;ActionGame;AdventureGame;Simulation;PackageManager;
Keywords=game;minecraft;mc;launcher;
StartupWMClass=@Launcher_CommonName@
MimeType=application/zip;application/x-modrinth-modpack+zip;x-scheme-handler/curseforge;x-scheme-handler/tismuslauncher;
